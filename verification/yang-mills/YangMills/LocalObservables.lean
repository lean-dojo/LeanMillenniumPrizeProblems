import YangMills.Classical

/-!
# Concrete local curvature expressions, Jaffe–Witten §4 and footnote 1

This is an explicit *classical* grammar of scalar polynomials generated by
bilinear pairings of curvature and its covariant derivatives. Evaluation is
pointwise on a smooth connection over ℝ⁴. Engineering dimensions are derived
from the expressions rather than supplied as arbitrary labels.

This is only part of the classical side of §4. We have not yet proved
local gauge covariance/invariance, represented the full algebra of differential
polynomials, established renormalized correspondence with quantum local
operators, or derived UV/OPE asymptotics. None of these missing obligations
can be discharged by constructing this grammar alone.
-/

noncomputable section

namespace YangMills

/-- The curvature tensor component F_{μν}, followed by a finite ordered
list of covariant derivatives. -/
structure CurvatureJet where
  mu : Fin 4
  nu : Fin 4
  derivatives : List (Fin 4)

/-- In 4D Yang–Mills engineering dimensions: [F] = 2 and [D] = 1. -/
def CurvatureJet.dimension (j : CurvatureJet) : ℕ :=
  2 + j.derivatives.length

/-- Recursive evaluation of the derivatives D_μ₁⋯D_μₙ F_{ρσ}. -/
def CurvatureJet.evaluate {G : CompactSimpleGaugeGroup}
    (j : CurvatureJet) (A : Connection G) : Spacetime → G.Algebra :=
  j.derivatives.foldr
    (fun μ f => fun x => A.covariantDerivative f μ x)
    (fun x => A.curvature x j.mu j.nu)

/-- A classical trace-pair generator Tr((D^I F_{μν})(D^J F_{ρσ})).
It is a concrete contraction with the invariant Lie-algebra quadratic form.
The *local gauge-transformation theorem* is not encoded here. -/
structure CurvatureTracePair where
  left : CurvatureJet
  right : CurvatureJet

def CurvatureTracePair.dimension (p : CurvatureTracePair) : ℕ :=
  p.left.dimension + p.right.dimension

def CurvatureTracePair.evaluate {G : CompactSimpleGaugeGroup}
    (p : CurvatureTracePair) (A : Connection G)
    (B : InvariantForm G) (x : Spacetime) : ℝ :=
  B.bilinear (p.left.evaluate A x) (p.right.evaluate A x)

/-- Scalar polynomials over the trace-pair generators. The multiplication
constructor permits finite algebraic products; degrees are upper bounds on
the engineering dimensions of summands, with addition taking their maximum. -/
inductive CurvatureScalarPolynomial where
  | constant (r : ℝ)
  | tracePair (p : CurvatureTracePair)
  | add (p q : CurvatureScalarPolynomial)
  | mul (p q : CurvatureScalarPolynomial)
  | scale (c : ℝ) (p : CurvatureScalarPolynomial)

namespace CurvatureScalarPolynomial

def dimension : CurvatureScalarPolynomial → ℕ
  | .constant _ => 0
  | .tracePair p => p.dimension
  | .add p q => max p.dimension q.dimension
  | .mul p q => p.dimension + q.dimension
  | .scale _ p => p.dimension

def evaluate {G : CompactSimpleGaugeGroup}
    (A : Connection G) (B : InvariantForm G) (x : Spacetime) :
    CurvatureScalarPolynomial → ℝ
  | .constant r => r
  | .tracePair p => p.evaluate A B x
  | .add p q => p.evaluate A B x + q.evaluate A B x
  | .mul p q => p.evaluate A B x * q.evaluate A B x
  | .scale c p => c * p.evaluate A B x

/-- The concrete classical dimension ≤ d filtration, not an arbitrary
predicate supplied by a putative proof of the mass gap. -/
def ofDimensionAtMost (d : ℕ) : Set CurvatureScalarPolynomial :=
  {p | p.dimension ≤ d}

theorem add_in_filtration (d : ℕ) (p q : CurvatureScalarPolynomial)
    (hp : p ∈ ofDimensionAtMost d) (hq : q ∈ ofDimensionAtMost d) :
    .add p q ∈ ofDimensionAtMost d := by
  change max p.dimension q.dimension ≤ d
  exact max_le hp hq

theorem scale_in_filtration (d : ℕ) (c : ℝ) (p : CurvatureScalarPolynomial)
    (hp : p ∈ ofDimensionAtMost d) :
    .scale c p ∈ ofDimensionAtMost d := hp

theorem mul_in_filtration (d e : ℕ) (p q : CurvatureScalarPolynomial)
    (hp : p ∈ ofDimensionAtMost d) (hq : q ∈ ofDimensionAtMost e) :
    .mul p q ∈ ofDimensionAtMost (d + e) := by
  exact Nat.add_le_add hp hq

end CurvatureScalarPolynomial

/-- The familiar Tr(F_{μν} F_{ρσ}) from §4, with engineering dimension 4. -/
def curvaturePair (μ ν ρ σ : Fin 4) : CurvatureTracePair :=
  ⟨⟨μ, ν, []⟩, ⟨ρ, σ, []⟩⟩

@[simp] theorem curvaturePair_dimension (μ ν ρ σ : Fin 4) :
    (curvaturePair μ ν ρ σ).dimension = 4 := by
  rfl

@[simp] theorem curvaturePair_evaluate {G : CompactSimpleGaugeGroup}
    (A : Connection G) (B : InvariantForm G) (x : Spacetime)
    (μ ν ρ σ : Fin 4) :
    (curvaturePair μ ν ρ σ).evaluate A B x =
      B.bilinear (A.curvature x μ ν) (A.curvature x ρ σ) := by
  rfl


/-- The quadratic classical action density is assembled from the concrete
dimension-four trace-pair generators, not from an arbitrary user-provided
scalar function. This establishes a link on the *classical* side only. -/
theorem actionDensity_eq_curvaturePairs {G : CompactSimpleGaugeGroup}
    (A : Connection G) (B : InvariantForm G) (x : Spacetime) :
    A.actionDensity B x =
      ∑ μ : Fin 4, ∑ ν : Fin 4,
        if μ < ν then (curvaturePair μ ν μ ν).evaluate A B x else 0 := by
  rfl

end YangMills
