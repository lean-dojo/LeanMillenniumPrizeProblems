import Problems.YangMills.CompositeExtraction
import Problems.YangMills.PerturbativeFlow
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse

-- Compatibility settings for the Lean 4.31 port of the reviewed source.
set_option backward.isDefEq.respectTransparency false
set_option warningAsError true

/-!
# Fixed free BV Ward operator and finite insertion coordinates

The free differential is generated by the SAME quadratic action S0 used by
the covariance/antifield vertices. It is not an independently selected table
or a witness-chosen quantum differential. The Ward coordinates below are a
concrete finite jet calculation, not automatically the physical qhat:
finite-cutoff Ward breaking, physical IR limits and scale transport must be
controlled before that identification is made.
-/
noncomputable section
open scoped ContDiff
namespace YangMills.PerturbativeFlow
open YangMills.Perturbative
variable {G : CompactSimpleGaugeGroup}

def bvPartner : ExternalLeg G → ExternalLeg G
  | .inl k => .inr k
  | .inr k => .inl k

def bvEulerSign : ExternalLeg G → ℂ
  | .inl k | .inr k => if k.fermionic then -1 else 1

/-- For the even quadratic action, right variation equals (-1)^parity
 times left variation. Combining the canonical BV partner and source sign
 gives this Hessian formula for s0(field/antifield). Momenta are (-p,p),
 since Euler variation differentiates the conjugate mode at -p. -/
def freeBVKernel (source target : ExternalLeg G) (p : Spacetime) : ℂ :=
  bvEulerSign source * freeVertexAmplitude G [bvPartner source, target]
    (fun i => if i.val = 0 then -p else p)

def replaceExternal (legs : List (ExternalLeg G)) (i : Fin legs.length)
    (source : ExternalLeg G) : List (ExternalLeg G) := legs.set i.val source

def replacedMomenta (legs : List (ExternalLeg G)) (i : Fin legs.length)
    (source : ExternalLeg G) (q : Fin legs.length → Spacetime) :
    Fin (replaceExternal legs i source).length → Spacetime :=
  fun j => q ⟨j.val, by simpa [replaceExternal] using j.isLt⟩

/-- The odd derivation on a coefficient tensor. Its prefix Koszul sign and
linear elementary-field transformation are both fixed. This applies to
inserted amplitudes with independent external momenta, as in the Ward identity. -/
def freeWardAmplitude (A : OrderedAmplitude G) : OrderedAmplitude G :=
  fun legs q => ∑ i : Fin legs.length, ∑ source : ExternalLeg G,
    (-1 : ℂ) ^ oddCount (legs.take i.val) *
      freeBVKernel source (legs.get i) (q i) *
      A (replaceExternal legs i source) (replacedMomenta legs i source q)

abbrev FiniteInsertionMatrix (n : ℕ) := Matrix (Fin n) (Fin n) ℂ
abbrev FormalInsertionMatrix (n : ℕ) := ℕ → FiniteInsertionMatrix n

/-- Row B, column C is D_B L(O_C), calculated on the same family. -/
def insertionNormalizationMatrix {n : ℕ} (labels : Fin n → LocalMonomial G)
    (L : InsertedFlowFamily G) (scale ultraviolet : ℝ) : FormalInsertionMatrix n :=
  fun loop row col => extractCoefficient (labels row)
    (L [⟨labels col, 0⟩] loop scale ultraviolet) 0

/-- The Ward right-hand side is the actual S0-derived free differential
applied to that same insertion, then extracted by the same D_B. -/
def freeWardNormalizationMatrix {n : ℕ} (labels : Fin n → LocalMonomial G)
    (L : InsertedFlowFamily G) (scale ultraviolet : ℝ) : FormalInsertionMatrix n :=
  fun loop row col => extractCoefficient (labels row)
    (freeWardAmplitude (L [⟨labels col, 0⟩] loop scale ultraviolet)) 0

/-- Formal matrix inverse by a triangular loop-order recursion. The tree
matrix is inverted as an actual finite matrix. Nonsingularity is an explicit
condition below, not permission to exploit the totalized singular inverse. -/
def inverseInsertionSeries {n : ℕ} (Z : FormalInsertionMatrix n)
    (loop : ℕ) : FiniteInsertionMatrix n :=
  if loop = 0 then (Z 0)⁻¹ else
    -(Z 0)⁻¹ * ∑ r : Fin loop, Z (loop - r.val) * inverseInsertionSeries Z r.val
termination_by loop

/-- Z^{-1}W. No matrix named qhat is supplied by an existence proof. Its
physical interpretation requires the full Ward identity and scale transport. -/
def finiteWardCoordinates {n : ℕ} (labels : Fin n → LocalMonomial G)
    (L : InsertedFlowFamily G) (scale ultraviolet : ℝ) : FormalInsertionMatrix n :=
  fun loop => ∑ r : Fin (loop + 1),
    inverseInsertionSeries (insertionNormalizationMatrix labels L scale ultraviolet) r.val *
      freeWardNormalizationMatrix labels L scale ultraviolet (loop - r.val)

/-- Legitimacy of the finite extraction requires real momentum smoothness,
actual admissible distinct monomials and a nonsingular tree normalization.
In a full filtered treatment the last fact follows from the fixed triangular
normalization conditions; it is not a Yang--Mills existence proof. -/
structure FiniteWardExtractionConditions {n : ℕ} (labels : Fin n → LocalMonomial G)
    (L : InsertedFlowFamily G) (scale ultraviolet : ℝ) : Prop where
  scale_positive : 0 < scale
  scale_ordered : scale ≤ ultraviolet
  admissible : ∀ i, (labels i).Admissible
  distinct : Function.Injective labels
  smooth : ∀ i loop legs, ContDiff ℝ ∞ (L [⟨labels i, 0⟩] loop scale ultraviolet legs)
  tree_nonsingular :
    (insertionNormalizationMatrix labels L scale ultraviolet 0).det ≠ 0

/-- Explicit formal nilpotence is an equation on the computed coordinates,
not an assumed abstract BV differential or a freely chosen Prop. It must be
proved from restored Ward identities after the physical identification. -/
def FormalWardNilpotent {n : ℕ} (Q : FormalInsertionMatrix n) : Prop :=
  ∀ loop, (∑ r : Fin (loop + 1), Q r.val * Q (loop - r.val)) = 0

/-- A full amplitude Ward identity, stronger than equality of a few jets.
This relation is used only AFTER the appropriate physical amplitudes and
transported coordinates have been fixed; no finite-cutoff identity is claimed. -/
def SatisfiesClosedFiniteWardIdentity {n : ℕ} (labels : Fin n → LocalMonomial G)
    (physical : LocalMonomial G → ℕ → OrderedAmplitude G)
    (coordinates : FormalInsertionMatrix n) : Prop :=
  ∀ col loop legs q,
    freeWardAmplitude (physical (labels col) loop) legs q =
      ∑ row : Fin n, ∑ r : Fin (loop + 1),
        coordinates r.val row col * physical (labels row) (loop - r.val) legs q

/-- The quantum differential raises engineering dimension by one; a
finite degree slice is therefore a rectangular source-to-larger-target map. -/
abbrev RectangularInsertionMatrix (rows cols : ℕ) := Matrix (Fin rows) (Fin cols) ℂ

def rectangularWardRHS {rows cols : ℕ}
    (outputs : Fin rows → LocalMonomial G) (inputs : Fin cols → LocalMonomial G)
    (L : InsertedFlowFamily G) (scale ultraviolet : ℝ) :
    ℕ → RectangularInsertionMatrix rows cols :=
  fun loop row col => extractCoefficient (outputs row)
    (freeWardAmplitude (L [⟨inputs col, 0⟩] loop scale ultraviolet)) 0

def rectangularWardCoordinates {rows cols : ℕ}
    (outputs : Fin rows → LocalMonomial G) (inputs : Fin cols → LocalMonomial G)
    (L : InsertedFlowFamily G) (scale ultraviolet : ℝ) :
    ℕ → RectangularInsertionMatrix rows cols :=
  fun loop => ∑ r : Fin (loop + 1),
    inverseInsertionSeries (insertionNormalizationMatrix outputs L scale ultraviolet) r.val *
      rectangularWardRHS outputs inputs L scale ultraviolet (loop - r.val)

/-- The enumeration must contain the entire actual monomial degree slice,
not a chosen square subblock which silently drops higher-degree outputs. -/
structure ExhaustiveMonomialSlice (G : CompactSimpleGaugeGroup) (D : ℕ) where
  count : ℕ
  label : Fin count → LocalMonomial G
  distinct : Function.Injective label
  exhaustive : ∀ m, (∃ i, label i = m) ↔ m.Admissible ∧ m.dimension < D

/-- Nilpotence composes D→D+1 with D+1→D+2. It is not a square-truncation
condition which can hide genuine outgoing components. -/
def RectangularWardNilpotent {low middle high : ℕ}
    (next : ℕ → RectangularInsertionMatrix high middle)
    (current : ℕ → RectangularInsertionMatrix middle low) : Prop :=
  ∀ loop, (∑ r : Fin (loop + 1), next r.val * current (loop - r.val)) = 0

def SatisfiesRectangularWardIdentity {rows cols : ℕ}
    (outputs : Fin rows → LocalMonomial G) (inputs : Fin cols → LocalMonomial G)
    (physical : LocalMonomial G → ℕ → OrderedAmplitude G)
    (coordinates : ℕ → RectangularInsertionMatrix rows cols) : Prop :=
  ∀ col loop legs q,
    freeWardAmplitude (physical (inputs col) loop) legs q =
      ∑ row : Fin rows, ∑ r : Fin (loop + 1),
        coordinates r.val row col * physical (outputs row) (loop - r.val) legs q

/-- The tree inverse is genuinely the actual fixed normalization inverse. -/
theorem inverseInsertionSeries_zero {n : ℕ} (Z : FormalInsertionMatrix n) :
    inverseInsertionSeries Z 0 = (Z 0)⁻¹ := by
  rw [inverseInsertionSeries]
  simp

end YangMills.PerturbativeFlow
