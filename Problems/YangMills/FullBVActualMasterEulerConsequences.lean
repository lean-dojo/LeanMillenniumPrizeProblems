import Problems.YangMills.FullBVActualClassicalMasterEquation

set_option backward.isDefEq.respectTransparency false
set_option warningAsError true
noncomputable section
namespace YangMills.FullBV
open YangMills.PerturbativeFlow YangMills.Perturbative
variable {G : CompactSimpleGaugeGroup}

/-- The proved actual CME has zero Euler gradients in every basic and
antifield coordinate. Quotient descent is proved, not assumed. -/
theorem masterAction_selfBracket_leftEuler {B : InvariantForm G} (e : ColorFrame B) (g : ℝ)
    (field : ExternalLeg G) :
    leftEuler field (densityBracket (masterActionDensity e g) (masterActionDensity e g)) = 0 := by
  have h := congrArg (leftEulerFunctional field) (masterAction_classicalMasterEquation e g)
  simpa only [leftEulerFunctional_localClass, map_zero] using h

theorem masterAction_selfBracket_rightEuler {B : InvariantForm G} (e : ColorFrame B) (g : ℝ)
    (field : ExternalLeg G) :
    rightEuler field (densityBracket (masterActionDensity e g) (masterActionDensity e g)) = 0 := by
  have h := congrArg (rightEulerFunctional field) (masterAction_classicalMasterEquation e g)
  simpa only [rightEulerFunctional_localClass, map_zero] using h

theorem masterAction_selfBracket_characteristic {B : InvariantForm G}
    (e : ColorFrame B) (g : ℝ) (field : ExternalLeg G) :
    stCharacteristic (densityBracket (masterActionDensity e g) (masterActionDensity e g)) field = 0 := by
  cases field <;> simp only [stCharacteristic, masterAction_selfBracket_rightEuler, neg_zero]

/-- The actual Hamiltonian field generated by the self-bracket vanishes
on EVERY point insertion. This preserves the full descendant algebra and
does not yet identify this Hamiltonian field with twice the ST square. -/
theorem masterAction_selfBracket_localST {B : InvariantForm G}
    (e : ColorFrame B) (g : ℝ) (P : JetAlgebra G) :
    localST (densityBracket (masterActionDensity e g) (masterActionDensity e g)) P = 0 := by
  unfold localST coordinateDifferential
  simp only [masterAction_selfBracket_characteristic, totalDerivatives_zeroInput,
    zero_mul, finsum_zero, add_zero]

end YangMills.FullBV
